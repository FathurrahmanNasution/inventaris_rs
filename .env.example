# Salin file ini menjadi .env (lokal) atau isi nilai yang sama di
# Vercel > Project Settings > Environment Variables. Jangan commit nilai asli.

# Connection string PostgreSQL Neon. Untuk Vercel gunakan versi "pooled"
# (host berakhiran -pooler), contoh bentuk:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Kunci penandatangan JWT, minimal 32 karakter acak. Aplikasi menolak berjalan bila kurang.
JWT_SECRET=

# production mengaktifkan cookie Secure (wajib saat diakses lewat HTTPS, termasuk Vercel).
NODE_ENV=development

# Port lokal untuk `npm start`. Tidak dipakai di Vercel.
PORT=3000

# Opsional. Origin publik persis untuk pemeriksaan CSRF, tanpa garis miring di akhir,
# mis. https://nama-proyek.vercel.app. Kosongkan bila tidak perlu.
APP_ORIGIN=

# Opsional. Jumlah maksimum koneksi pool. Bawaan: 3 di Vercel, 10 di lokal.
PG_POOL_MAX=

# Opsional. Percayai header X-Forwarded-* dari reverse proxy (mis. 1 atau loopback).
# Otomatis aktif di Vercel; kosongkan saat menjalankan lokal tanpa proxy.
TRUST_PROXY=
